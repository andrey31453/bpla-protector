{% from "partials/head.njk" import head %}
{% from "partials/header.njk" import header %}
{% from "partials/footer.njk" import footer %}
{% from "partials/rail.njk" import rail %}
{% from "partials/metrika.njk" import metrika %}
<!doctype html>
<html lang="ru">
<head>
  {{ head(page) }}
  <link rel="stylesheet" href="/src/style.css">
</head>
<body>
  {{ header(page) }}
  <main id="main">
  {# ШКАЛА РАЗДЕЛОВ: «счётчик блоков» страницы у левой кромки окна — точка на
     секцию, активная становится медной, при наведении открывается тёмная
     подложка с подписями. Стоит первой в <main> и подключена здесь, поэтому
     есть на каждой странице сайта; состав точек собирается на сборке из самих
     секций (см. nunjucks-plugin.mjs), а на странице с одной секцией не
     выводится. #}
  {{ rail() }}
{% block content %}{% endblock %}
  </main>
  {{ footer() }}
  {# СЧЁТЧИК ЯНДЕКС.МЕТРИКИ: подключён в базовом макете, поэтому сниппет стоит
     на каждой странице сайта. Номер счётчика и адреса — в site.json
     (analytics.yandexMetrika), сама разметка — в partials/metrika.njk.
     Стоит последним в <body>: загрузчик асинхронный, отрисовку не задерживает. #}
  {{ metrika() }}
</body>
</html>
