{# ---------- показатели (company.kpi) — отдельная полоса цифр ---------- #}
{# На главной секция стоит сразу после «Уровни защиты по СП 542.1325800.2024»:
   первый показатель — про уровень защиты, поэтому полоса продолжает тему уровней
   и читается как факты о системе. Раньше эта строка замыкала секцию «О компании»
   (блок .about__stats внутри sAbout); вынесена в самостоятельную секцию, чтобы
   цифры были своим блоком и не спорили с карточками состава работ.

   Светлая подложка (light = true) выбрана осознанно: карточки .stat рассчитаны на
   светлую секцию (.on-light .stat — белая карточка с рамкой и мягкой тенью), а
   между оранжевой полосой уровней и тёмной полосой гарантий светлая полоса даёт
   воздух.

   Заголовок у полосы есть: без него блок выглядел безымянной россыпью чисел, а по
   kicker и h2 сразу видно, что это за цифры. Title «Ключевые цифры»
   (company.kpi.title) берёт формулировку из ТЗ директолога; kicker «Показатели» —
   нейтральная рамка («характеристики и сроки изделий», не обещание результата).
   Слово «Ориентиры» в kicker не берём: на той же странице оно уже стоит у секции
   стоимости (#ceny), а два одинаковых кикера на одной странице читаются как опечатка.
   Текст заголовка — навигационный, а не заявление о продукте, поэтому живёт в
   данных, а не в разметке. Заголовок выводит общий ui.head — тот же, что у
   остальных секций, поэтому типографика и отступы совпадают.

   id по умолчанию — pokazateli: тот же анкер, что был у строки внутри секции
   о компании, поэтому внешние ссылки на #pokazateli продолжают работать. #}
{% macro sKpi(b, light, id) -%}
{% if b.items | length %}
{% call wrap(id or 'pokazateli', light) %}
  {{ ui.head(b) }}
  {{ ui.stats(b.items, 'mt-10') }}
{% endcall %}
{% endif %}
{%- endmacro %}

{# карточка линии предложения: фото сверху, под ним иконка, заголовок, лид,
   список и кнопка. Обе линии собираются одной карточкой, поэтому идут в
   одинаковом порядке и читаются как пара. #}
{% macro lineCard(item) -%}
<article class="linecard reveal">
  {{ ui.media(item.photo, 'linecard__media') }}
  <div class="linecard__body">
    {% if item.icon %}{{ ui.icon(item.icon, 'h-8 w-8 text-flame') }}{% endif %}
    <h3 class="h3{{ ' mt-5' if item.icon else '' }}">{{ item.title }}</h3>
    <p class="panel__meta mt-3">{{ item.lead | default(item.text) }}</p>
    {% if item.bullets %}{{ ui.tick(item.bullets) }}{% endif %}
    {% if item.cta %}<div class="mt-7">{{ ui.button(item.cta, 'btn--ghost') }}</div>{% endif %}
  </div>
</article>
{%- endmacro %}

{# две линии предложения: вынесенный рубеж и локальная защита #}
{% macro sLines(b, light, id) -%}
{% call wrap(id or 'linii', light, none, b.deco) %}
  {{ ui.head(b) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {% for item in b.items %}{{ lineCard(item) }}{% endfor %}
  </div>
{% endcall %}
{%- endmacro %}

{# каталог направлений из data/products.json. На главной стоит сразу после секции
   о компании: сначала «что защищаем и как», ниже (после «Контекста объекта») —
   оранжевая галерея «как это выглядит на объектах». Порядок — index.html. #}
{% macro sCatalog(light, id) -%}
{% call wrap(id or 'napravleniya', light, none, data.products.block.deco) %}
  {{ ui.head(data.products.block) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for item in data.products.items %}
    <article class="panel flex flex-col p-6 reveal">
      {{ ui.icon(item.icon, 'h-7 w-7 text-flame') }}
      <h3 class="h3 mt-5">{{ item.title }}</h3>
      <p class="panel__meta mt-3">{{ item.lead }}</p>
      {{ ui.tick(item.bullets) }}
      {{ ui.chips(item.tags) }}
      {# Подвал карточки: линия — отдельным div, кнопка — под ним.
         mt-auto прижимает подвал к нижней кромке карточки (карточки в ряду
         выравниваются по самой высокой), поэтому между чипами и линией
         оставался не зазор, а случайный остаток высоты: у самой высокой карточки
         ряда он равен нулю — линия слипалась с чипами. Свой отступ у border-top
         этого не лечит: паддинг ложится ВНУТРЬ блока, то есть ниже линии.
         Поэтому зазор сверху даёт обёртка (pt-5), а отступ до кнопки — сам
         блок линии (pt-5 у пустого div = 1 px линии + 20 px воздуха под ней).
         Слой декоративный: линии, кроме вида, ничего не несут — aria-hidden. #}
      <div class="mt-auto pt-5">
        <div class="border-t border-flame/30 pt-5" aria-hidden="true"></div>
        <a class="btn btn--ghost" href="{{ href(item.slug) }}">{{ item.cta }}{{ ui.icon('arrow', 'h-4 w-4') }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
{% endcall %}
{%- endmacro %}

{# сводные цены по направлениям: данные берём из цен лендингов, не дублируем.
   Пять таблиц подряд занимали несколько экранов, поэтому направления собраны в
   один блок с переключателем: имена направлений — по одной записи pages.json,
   содержимое панели — из landing-<slug>.json (поле prices).
   Разметка остаётся статической: в HTML лежат все панели целиком, поэтому
   таблицы и ссылки видны поиску без исполнения JS. Классы переключает модуль
   tabs.js; без него (нет класса js) панели показываются списком, как раньше. #}
{% macro sPricesAll(light) -%}
{% call wrap('ceny', light, none, data.ceny.prices.deco) %}
  {{ ui.head(data.ceny.prices) }}
  <div class="tabs mt-10" data-tabs>
    <div class="tabs__list" role="tablist" aria-label="Направления защиты">
      {% for p in pages %}
      {% set lp = data['landing-' + p.slug] %}
      {% if lp and lp.prices %}
      <button type="button" class="tabs__tab" role="tab" id="ceny-tab-{{ p.slug }}" aria-controls="ceny-panel-{{ p.slug }}">{{ p.nav }}</button>
      {% endif %}
      {% endfor %}
    </div>
    <div class="tabs__panels">
      {% for p in pages %}
      {% set lp = data['landing-' + p.slug] %}
      {% if lp and lp.prices %}
      <section class="tabs__panel" role="tabpanel" id="ceny-panel-{{ p.slug }}" aria-labelledby="ceny-tab-{{ p.slug }}">
        <p class="lead">{{ lp.prices.lead }}</p>
        {% if lp.prices.table %}{{ ui.tbl(lp.prices.table.head, lp.prices.table.rows) }}{% elif lp.prices.head | length %}{{ ui.tbl(lp.prices.head, lp.prices.rows) }}{% endif %}
        {% if lp.prices.note %}{{ ui.note(lp.prices.note) }}{% endif %}
        <div class="mt-6">
          <a class="btn btn--ghost" href="{{ href(p.slug, 'zayavka') }}">Расчёт по этому направлению{{ ui.icon('arrow', 'h-4 w-4') }}</a>
        </div>
      </section>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {{ ui.note(data.ceny.prices.note, 'accent') }}
{% endcall %}
{%- endmacro %}

{# ---------- 18. Объекты: как выглядят защитные конструкции на объектах (галерея) ---------- #}
{# Набор фотографий лежит в data/objects.json. Направление может передать свой
   набор (например data['landing-mosty'].objects): тогда items берутся из него,
   а data.objects.block остаётся набором по умолчанию.
   На главной секция стоит в средней части страницы: выше — светлый «Контекст
   объекта», ниже — светлая «Вокруг конструкции продолжается работа». Между двумя
   светлыми блоками галерея оформлена оранжевой полосой — тем же фоном, что и CTA
   («Пришлите данные по объекту»): так она читается акцентом. #}
{% macro sObjects(b, id) -%}
{% call wrap(id or 'obekty', false, 'flame-band') %}
  {# set внутри блока call: см. пояснение у sMaterials #}
  {% set o = b if b else data.objects.block %}
  {{ ui.head(o) }}
  <div class="shots mt-10">
    {% for item in o.items %}{{ ui.shot(item) }}{% endfor %}
  </div>
  {% if o.note %}{{ ui.note(o.note, 'ink') }}{% endif %}
{% endcall %}
{%- endmacro %}


{# ---------- 19. О компании и состав работ (главная) ---------- #}
{# Секция идёт сразу под первым экраном: слева короткий рассказ о компании,
   справа белые карточки состава работ. Строки показателей в секции больше нет:
   цифры (company.kpi.items) вынесены отдельной секцией sKpi и стоят ниже — после
   «Уровни защиты по СП 542.1325800.2024» (пояснение — у макроса sKpi).

   Ссылок в карточках нет намеренно: это компетенции, а не разделы сайта, и
   обещать переход там нечем — поэтому разметка без <a> (оформление — .catcard
   в style.css). Тексты — company.about, числа — company.kpi.items; имя бренда
   берётся из site.json (brandParts), чтобы название компании не дублировалось.

   У каждой карточки сверху — кадр по теме блока (ui.cardMedia, company.about.items),
   ниже иконка с заголовком и текст: иконка остаётся смысловой меткой карточки,
   фото — иллюстрацией темы. Кадры лежат в public/images/kompetencii/.

   Карточки идут в порядке ведения работ (он задан порядком company.about.items):
   проектирование → производство конструкций → монтаж → противоосколочные блоки →
   документация → сопровождение. Номер карточки (его выводит ui.cardMedia поверх
   кадра) — loop.index, то есть позиция в этом же массиве: цифры не могут
   разойтись с порядком, а перестановка пунктов в данных переставляет и их. #}
{% macro sAbout(b, id) -%}
{% call wrap(id or 'o-kompanii', true, none, b.deco) %}
  <div class="about">
    <div class="about__intro">
      <span class="kicker">{{ b.kicker }}</span>
      <h2 class="h2 about__title mt-4">
        <span class="about__brand">{{ site.brandParts.head }}<span class="brand__accent">{{ site.brandParts.accent }}</span>{{ site.brandParts.tail }}</span>
        {{ b.titleSuffix }}
      </h2>
      <p class="lead mt-4">{{ b.lead }}</p>
      {# Кнопка «Подробнее о компании» ведёт на страницу o-kompanii.html: href и
         подпись приходят из company.about.cta, как у остальных кнопок сайта.
         Пока страницы не было, кнопка была <span> без цели с погашенным
         наведением — это правило убрано из style.css вместе с её появлением. #}
      {{ ui.button(b.cta, 'btn--ink about__cta') }}
    </div>
    <div class="catcards">
      {% for item in b.items %}
      <article class="catcard reveal">
        {% if item.img %}{{ ui.cardMedia(item, loop.index) }}{% endif %}
        <div class="catcard__head">
          {{ ui.icon(item.icon | default('shield'), 'catcard__icon') }}
          <h3 class="catcard__title">{{ item.title }}</h3>
        </div>
        <p class="catcard__text">{{ item.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
{% endcall %}
{%- endmacro %}

{# ---------- 20. Полоса «Полный комплекс» (главная) ---------- #}
{# Отдельная секция с чёрной подложкой сразу под баннером: пять пунктов
   комплекса работ — от расчёта до передачи документации. Идёт самостоятельной
   полосой, а не частью первого экрана: чёрный (--color-void) отделяет кадр
   баннера от светлой секции «О компании» и на стыке видно, что это другой блок.
   Заголовок только для структуры документа (sr-only): видимого заголовка у
   полосы нет, роль заголовка играет крупная строка этапов на первом экране,
   дублировать её текстом здесь не нужно. Пункты — company.features.items. #}
{% macro sFeatures(b, id) -%}
{% call wrap(id or 'kompleks', false, 'feat-band') %}
  <h2 class="sr-only">{{ b.title }}</h2>
  {{ ui.featureRow(b.items) }}
{% endcall %}
{%- endmacro %}

