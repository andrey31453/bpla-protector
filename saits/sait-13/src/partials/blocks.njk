{# ============================================================
   blocks.njk — секции страниц. Каждая секция собирается из JSON-данных
   и повторно используется на разных страницах (лендинги, каталог, услуги).
   Фактические значения (таблицы, списки, нормы) берутся из общих файлов
   data/materials.json, data/levels.json, data/normatives.json, data/products.json.
   ============================================================ #}
{% import "macros/ui.njk" as ui %}

{# обёртка секции: id + тёмный/светлый фон.
   variant переопределяет фон целиком — например 'flame-band' (оранжевая полоса, как CTA). #}
{% macro wrap(id, light, variant) -%}
<section class="band {{ variant or ('on-light' if light else 'grid-bg') }}"{% if id %} id="{{ id }}"{% endif %}>
  <div class="shell">{{ caller() }}</div>
</section>
{%- endmacro %}

{# ---------- 1. Проблема объекта ---------- #}
{% macro sProblem(b, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {{ ui.cards(b.items, 'md:grid-cols-2 lg:grid-cols-3') }}
{% endcall %}
{%- endmacro %}

{# ---------- 2. Узлы объекта (таблица) ---------- #}
{% macro sNodes(b, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {{ ui.tbl(b.head, b.rows) }}
{% endcall %}
{%- endmacro %}

{# ---------- 3. Типы конструкций ---------- #}
{% macro sConstructions(b, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {{ ui.cards(b.items, 'md:grid-cols-2 lg:grid-cols-3') }}
{% endcall %}
{%- endmacro %}

{# ---------- 4. Ограничения: таблица или карточки ---------- #}
{% macro sLimits(b, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {% if (b.head | length) and (b.rows | length) %}{{ ui.tbl(b.head, b.rows) }}{% endif %}
  {% if b.items | length %}{{ ui.cards(b.items, 'md:grid-cols-2 lg:grid-cols-3') }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 5. Материалы: общая таблица + пояснения + «почему не используем» ---------- #}
{# Внимание: переменные из {% set %} в теле макроса НЕ видны внутри его
   собственного {% call %} — поэтому set стоит внутри блока. #}
{% macro sMaterials(b, light, id) -%}
{% call wrap(id, light) %}
  {% set m = data.materials %}
  {{ ui.head(b) }}
  {{ ui.tbl(m.head, m.rows) }}
  {{ ui.cards(m.notes, 'md:grid-cols-2 lg:grid-cols-3') }}
  <div class="panel panel--accent mt-10 p-6 md:p-8">
    <h3 class="h3">{{ m.whyNot.title }}</h3>
    {{ ui.tick(m.whyNot.reasons) }}
    {{ ui.note(m.whyNot.verdict, 'accent') }}
  </div>
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 6. Состав работ / услуги ---------- #}
{% macro sServices(b, light, id) -%}
{% call wrap(id or 'uslugi', light) %}
  {{ ui.head(b) }}
  <ol class="numlist mt-10">
    {% for item in b.items %}
    <li class="reveal">
      <div class="flex items-center gap-3">
        {{ ui.icon(item.icon | default('gear'), 'h-5 w-5 text-flame') }}
        <h3 class="h3">{{ item.title }}</h3>
      </div>
      <p class="panel__meta mt-3">{{ item.text }}</p>
    </li>
    {% endfor %}
  </ol>
{% endcall %}
{%- endmacro %}

{# ---------- 7. Нормативная база: реестр документов с выходом на первоисточник ---------- #}
{# Блок собран как рабочий реестр, а не как перечень кодов: сводка по количеству
   документов, деление на группы (законы и подзаконные акты / своды правил и
   стандарты / отраслевые документы), официальное название, роль документа в
   проекте и кнопка к тексту. Кнопка ведёт на первоисточник (ФГИС Росстандарта,
   официальный портал опубликования правовых актов, справочная правовая
   система); там, где карточки в открытом доступе нет, — на форму заявки:
   редакцию с изменениями выдаём вместе с расчётом.
   Под списком — панель о патентной чистоте, экспертизе, закупках и допуске на
   объект: расширяет тему документов до того, что заказчик видит на проверке.
   Все данные, порядок групп и формулировки — data/normatives.json (_note). #}
{% macro sNormatives(b, slug, light, id) -%}
{% call wrap(id or 'normativy', light) %}
  {% set n = data.normatives %}
  {{ ui.head(b or n.block) }}
  {# отбор по scope выполняем один раз: этот же список идёт и в сводку, и в группы #}
  {% set shown = [] %}
  {% for item in n.items %}
    {% if slug == 'index' or ('all' in item.scope) or (slug in item.scope) %}
      {% set shown = shown.concat([item]) %}
    {% endif %}
  {% endfor %}
  <div class="docmeta mt-8">
    {{ ui.icon('doc', 'h-5 w-5 text-flame') }}
    <p class="docmeta__count"><b>{{ shown | length }}</b> {{ n.summary.countLabel }}</p>
    <p class="docmeta__total">{{ n.items | length }} {{ n.summary.totalLabel }}</p>
    <p class="docmeta__src">{{ n.summary.sourceLabel }}</p>
  </div>
  {% set grouped = shown | groupby('group') %}
  {% for g in n.groups %}
    {% set gitems = grouped[g.key] | default([]) %}
    {% if gitems | length %}
    <div class="docgroup">
      <div class="docgroup__head">
        <h3 class="docgroup__title">{{ g.title }}</h3>
        <span class="docgroup__count">{{ gitems | length }}</span>
      </div>
      <p class="docgroup__note">{{ g.note }}</p>
      <div class="docgrid">
        {% for item in gitems %}{{ ui.docCard(item) }}{% endfor %}
      </div>
    </div>
    {% endif %}
  {% endfor %}
  {% if n.summary.note %}{{ ui.note(n.summary.note, 'accent') }}{% endif %}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
  {# Патентная чистота, экспертиза, закупки и допуск на объект: отвечает на вопрос
     «а пройдёт ли это у нас на согласовании и проверке». #}
  {% set p = n.practice %}
  <div class="panel panel--accent panel--practice mt-12 p-6 md:p-8">
    <span class="kicker">{{ p.kicker }}</span>
    <h3 class="h3 mt-4">{{ p.title }}</h3>
    <p class="lead mt-4 max-w-4xl">{{ p.lead }}</p>
    <div class="practice-grid mt-8">
      {% for item in p.items %}
      <div class="practice reveal">
        {{ ui.icon(item.icon | default('doc'), 'h-6 w-6 text-flame') }}
        <h4 class="practice__title">{{ item.title }}</h4>
        <p class="panel__meta mt-2">{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>
    {{ ui.note(p.note, 'accent') }}
  </div>
{% endcall %}
{%- endmacro %}

{# ---------- 8. Уровни защиты по СП 542 ---------- #}
{% macro sLevels(b, slug, light, id) -%}
{% call wrap(id or 'urovni', light) %}
  {{ ui.head(b or data.levels.block) }}
  <div class="table-scroll mt-8">
    <table class="tbl">
      <thead><tr>{% for th in data.levels.head %}<th scope="col">{{ th }}</th>{% endfor %}</tr></thead>
      <tbody>
        {% for row in data.levels.rows %}
        <tr><td>{{ row.level }}</td><td>{{ row.drone }}</td><td>{{ row.structure }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% set lnote = data.levels.notes[slug] %}
  {% if lnote %}{{ ui.note(lnote, 'accent') }}{% endif %}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 9. Категорирование объекта ---------- #}
{% macro sCategory(b, light, id) -%}
{% call wrap(id or 'kategorizaciya', light) %}
  {{ ui.head(b) }}
  {{ ui.tbl(b.head, b.rows) }}
  {% if b.note %}{{ ui.note(b.note, 'accent') }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 10. Сертификаты, испытания, гарантия ---------- #}
{% macro sProof(b, light, id) -%}
{% call wrap(id or 'podtverzhdeniya', light) %}
  {{ ui.head(b) }}
  {{ ui.cards(b.items, 'md:grid-cols-2 lg:grid-cols-4') }}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 11. Примеры работ / решения ---------- #}
{% macro caseRow(label, text) -%}
<p class="mt-4">
  <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-flame">{{ label }}</span>
  <span class="mt-1 block text-sm text-mist">{{ text }}</span>
</p>
{%- endmacro %}

{% macro sCases(b, light, id) -%}
{% call wrap(id or 'keysy', light) %}
  {{ ui.head(b) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for c in b.items %}
    <article class="panel p-6 reveal">
      <h3 class="h3">{{ c.title }}</h3>
      {{ caseRow('Задача', c.task) }}
      {{ caseRow('Решение', c.solution) }}
      {{ caseRow('Сроки', c.term) }}
      {{ caseRow('Результат', c.result) }}
    </article>
    {% endfor %}
  </div>
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 12. Заказчики и сегменты ---------- #}
{% macro sClients(b, light, id) -%}
{% call wrap(id or 'zakazchiki', light) %}
  {{ ui.head(b) }}
  {{ ui.tiles(b.segments, 'md:grid-cols-2 lg:grid-cols-3') }}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 13. Документация по итогам работ ---------- #}
{% macro sDocs(b, light, id) -%}
{% call wrap(id or 'dokumentaciya', light) %}
  {{ ui.head(b) }}
  {{ ui.docrows(b.items) }}
{% endcall %}
{%- endmacro %}

{# ---------- 14. Тендеры и закупки ---------- #}
{% macro sTenders(b, light, id) -%}
{% call wrap(id or 'tendery', light) %}
  {{ ui.head(b) }}
  {{ ui.tick(b.items) }}
{% endcall %}
{%- endmacro %}

{# ---------- 15. Стоимость ---------- #}
{% macro sPrices(b, light, id) -%}
{% call wrap(id or 'ceny', light) %}
  {{ ui.head(b) }}
  {% if b.table %}{{ ui.tbl(b.table.head, b.table.rows) }}{% elif b.head | length %}{{ ui.tbl(b.head, b.rows) }}{% endif %}
  {% if b.factors | length %}
  <h3 class="h3 mt-12">Что влияет на стоимость</h3>
  {{ ui.tick(b.factors) }}
  {% endif %}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
  {% if b.cta %}<div class="mt-9">{{ ui.button(b.cta, 'btn--primary') }}</div>{% endif %}
{% endcall %}
{%- endmacro %}

{# ---------- 16. FAQ страницы ---------- #}
{% macro sFaq(slug, light, id) -%}
{% if data['faq-' + slug] and (data['faq-' + slug].items | length) %}
{% call wrap(id or 'faq', light) %}
  {# set внутри блока call: см. пояснение у sMaterials #}
  {% set f = data['faq-' + slug] %}
  <span class="kicker">Частые вопросы</span>
  <h2 class="h2 mt-4">{{ f.title }}</h2>
  <p class="lead mt-4 max-w-4xl">{{ f.lead }}</p>
  <div class="mt-10">{{ ui.faq(f) }}</div>
{% endcall %}
{% endif %}
{%- endmacro %}

{# ---------- 17. Универсальные блоки ---------- #}
{% macro sCards(b, light, id, cols) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {{ ui.cards(b.items, cols or 'md:grid-cols-2 lg:grid-cols-3') }}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# типы конструкций из всех направлений — для страницы «Конструкции и материалы» #}
{% macro sTypesAll(b, light, id) -%}
{% call wrap(id or 'tipy', light) %}
  {{ ui.head(b) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for p in pages %}
    {% set lp = data['landing-' + p.slug] %}
    {% if lp and lp.constructions %}
    {% for item in lp.constructions.items %}
    <article class="panel flex flex-col p-6 reveal">
      {{ ui.icon(item.icon | default('shield'), 'h-7 w-7 text-flame') }}
      <h3 class="h3 mt-5">{{ item.title }}</h3>
      <p class="panel__meta mt-3">{{ item.text }}</p>
      <div class="mt-auto pt-5">{{ ui.chips([p.nav]) }}</div>
    </article>
    {% endfor %}
    {% endif %}
    {% endfor %}
  </div>
{% endcall %}
{%- endmacro %}

{% macro sTick(b, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.head(b) }}
  {{ ui.tick(b.items) }}
  {% if b.note %}{{ ui.note(b.note) }}{% endif %}
{% endcall %}
{%- endmacro %}

{# показатели (company.kpi) #}
{% macro sKpi(items, light, id) -%}
{% call wrap(id, light) %}
  {{ ui.stats(items) }}
{% endcall %}
{%- endmacro %}

{# две линии предложения: вынесенный рубеж и локальная защита #}
{% macro sLines(b, light, id) -%}
{% call wrap(id or 'linii', light) %}
  {{ ui.head(b) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {% for item in b.items %}
    <article class="panel panel--accent p-6 md:p-8 reveal">
      {{ ui.icon(item.icon, 'h-8 w-8 text-flame') }}
      <h3 class="h3 mt-5">{{ item.title }}</h3>
      <p class="panel__meta mt-3">{{ item.lead }}</p>
      {{ ui.tick(item.bullets) }}
      <div class="mt-7">{{ ui.button(item.cta, 'btn--ghost') }}</div>
    </article>
    {% endfor %}
  </div>
{% endcall %}
{%- endmacro %}

{# каталог направлений из data/products.json #}
{% macro sCatalog(light, id) -%}
{% call wrap(id or 'napravleniya', light) %}
  {{ ui.head(data.products.block) }}
  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for item in data.products.items %}
    <article class="panel flex flex-col p-6 reveal">
      {{ ui.icon(item.icon, 'h-7 w-7 text-flame') }}
      <h3 class="h3 mt-5">{{ item.title }}</h3>
      <p class="panel__meta mt-3">{{ item.lead }}</p>
      {{ ui.tick(item.bullets) }}
      {{ ui.chips(item.tags) }}
      <div class="mt-auto border-t border-flame/30 pt-5">
        <a class="btn btn--ghost" href="{{ href(item.slug) }}">{{ item.cta }}{{ ui.icon('arrow', 'h-4 w-4') }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
{% endcall %}
{%- endmacro %}

{# сводные цены по направлениям: данные берём из цен лендингов, не дублируем.
   Пять таблиц подряд занимали несколько экранов, поэтому направления собраны в
   один блок с переключателем: имена направлений — по одной записи pages.json,
   содержимое панели — из landing-<slug>.json (поле prices).
   Разметка остаётся статической: в HTML лежат все панели целиком, поэтому
   таблицы и ссылки видны поиску без исполнения JS. Классы переключает модуль
   tabs.js; без него (нет класса js) панели показываются списком, как раньше. #}
{% macro sPricesAll(light) -%}
{% call wrap('ceny', light) %}
  {{ ui.head(data.ceny.prices) }}
  <div class="tabs mt-10" data-tabs>
    <div class="tabs__list" role="tablist" aria-label="Направления защиты">
      {% for p in pages %}
      {% set lp = data['landing-' + p.slug] %}
      {% if lp and lp.prices %}
      <button type="button" class="tabs__tab" role="tab" id="ceny-tab-{{ p.slug }}" aria-controls="ceny-panel-{{ p.slug }}">{{ p.nav }}</button>
      {% endif %}
      {% endfor %}
    </div>
    <div class="tabs__panels">
      {% for p in pages %}
      {% set lp = data['landing-' + p.slug] %}
      {% if lp and lp.prices %}
      <section class="tabs__panel" role="tabpanel" id="ceny-panel-{{ p.slug }}" aria-labelledby="ceny-tab-{{ p.slug }}">
        <p class="lead">{{ lp.prices.lead }}</p>
        {% if lp.prices.table %}{{ ui.tbl(lp.prices.table.head, lp.prices.table.rows) }}{% elif lp.prices.head | length %}{{ ui.tbl(lp.prices.head, lp.prices.rows) }}{% endif %}
        {% if lp.prices.note %}{{ ui.note(lp.prices.note) }}{% endif %}
        <div class="mt-6">
          <a class="btn btn--ghost" href="{{ href(p.slug, 'zayavka') }}">Расчёт по этому направлению{{ ui.icon('arrow', 'h-4 w-4') }}</a>
        </div>
      </section>
      {% endif %}
      {% endfor %}
    </div>
  </div>
  {{ ui.note(data.ceny.prices.note, 'accent') }}
{% endcall %}
{%- endmacro %}

{# ---------- 18. Объекты: как выглядят защитные конструкции на объектах (галерея) ---------- #}
{# Набор фотографий лежит в data/objects.json. Направление может передать свой
   набор (например data['landing-mosty'].objects): тогда items берутся из него,
   а data.objects.block остаётся набором по умолчанию.
   Секция стоит в верху страницы сразу после блока цифр, поэтому оформлена
   оранжевой полосой — тем же фоном, что и CTA («Пришлите данные по объекту»):
   два светлых блока подряд сливались бы, а так галерея читается как акцент. #}
{% macro sObjects(b, id) -%}
{% call wrap(id or 'obekty', false, 'flame-band') %}
  {# set внутри блока call: см. пояснение у sMaterials #}
  {% set o = b if b else data.objects.block %}
  {{ ui.head(o) }}
  <div class="shots mt-10">
    {% for item in o.items %}{{ ui.shot(item) }}{% endfor %}
  </div>
  {% if o.note %}{{ ui.note(o.note, 'ink') }}{% endif %}
{% endcall %}
{%- endmacro %}


