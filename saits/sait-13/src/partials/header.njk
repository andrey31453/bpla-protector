{# ============================================================
   header.njk — закреплённая шапка: логотип, меню и контакты.
   Меню собирается из pages.json (navGroups); контакты — из site.json.
   Десктопное меню открывается на hover/focus (CSS), мобильное — <details>.

   Верхней строки контактов над шапкой нет: телефон — главный контакт на сайте,
   поэтому он стоит в шапке крупно и рядом с кнопкой заявки (как на референсе
   заказчика), а регион, режим работы и e-mail остаются в подвале и в блоке
   заявки — там же, где и были, из того же site.json.
   ============================================================ #}
{% import "macros/ui.njk" as ui %}
{% from "partials/brand.njk" import brandLogo %}

{% macro header(pg) -%}
<header class="site-header">
  <div class="shell flex items-center justify-between gap-6 py-3">
    {{ brandLogo() }}

    <nav class="hidden lg:flex items-center gap-6" aria-label="Основное меню">
      {% for group in navGroups %}
      <div class="nav-group">
        <button class="nav-group__btn" type="button" aria-haspopup="true">{{ group.label }}{{ ui.icon('chev', 'h-3.5 w-3.5') }}</button>
        <div class="nav-group__list">
          {% for item in group.items %}
          <a href="{{ href(item.slug) }}" {% if item.slug == pg.slug %}aria-current="page"{% endif %}>{{ item.nav }}</a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </nav>

    {# Правый блок: телефон крупно и над кнопкой заявки (как на референсе
       заказчика). Значения — из site.json, ссылка — tel:. Кнопка здесь
       контурная: акцент шапки — номер, а не кнопка. #}
    <div class="header-contacts hidden lg:flex flex-col items-end gap-2">
      <a class="header-phone" href="tel:{{ site.phone.href }}">
        {{ ui.icon('phone', 'header-phone__icon') }}{{ site.phone.display }}
      </a>
      <a class="btn btn--ghost btn--sm header-cta" href="{{ href('kontakty', 'zayavka') }}">Запросить расчёт</a>
    </div>

    {# details намеренно без `relative`: панель меню позиционируется по sticky-шапке,
       иначе у shrink-to-fit флекс-элемента ширина схлопывается до ширины кнопки «Меню» #}
    <details class="mnav lg:hidden">
      <summary>Меню{{ ui.icon('chev', 'h-3.5 w-3.5') }}</summary>
      <div class="mnav__panel">
        {# Прокручивается только список разделов, кнопки закреплены внизу панели:
           так «Запросить расчёт» виден сразу, а пункт списка не режется краем. #}
        <div class="mnav__scroll">
          <p class="mnav__title">Разделы</p>
          <a href="{{ href('index') }}">Главная</a>
          {% for group in navGroups %}
          <p class="mnav__title mt-5">{{ group.label }}</p>
          {% for item in group.items %}
          <a href="{{ href(item.slug) }}" {% if item.slug == pg.slug %}aria-current="page"{% endif %}>{{ item.nav }}</a>
          {% endfor %}
          {% endfor %}
        </div>
        <div class="mnav__foot">
          <a class="btn btn--primary" href="{{ href('kontakty', 'zayavka') }}">Запросить расчёт</a>
          <a class="btn btn--ghost mnav-phone" href="tel:{{ site.phone.href }}">{{ site.phone.display }}</a>
        </div>
      </div>
    </details>
  </div>
</header>
{%- endmacro %}
