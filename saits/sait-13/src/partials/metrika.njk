{# ============================================================
   metrika.njk — счётчик Яндекс.Метрики.

   Данные — src/data/site.json → analytics.yandexMetrika (id, scriptUrl,
   watchUrl): номер счётчика в разметке не хардкодится (п. 4.2 правил).
   Вызывает этот макрос layouts/base.njk сразу после подвала, поэтому
   сниппет стоит на каждой странице сайта, а не копируется по файлам.

   Параметры init — по официальному сниппету счётчика: ssr и вебвизор
   включены; карта кликов, ecommerce в dataLayer, referrer и url, точный
   показатель отказов и трекинг внешних ссылок передаются как есть.

   Нужно отключить счётчик (локальная сборка, копия сайта на другом
   домене, тесты) — уберите analytics.yandexMetrika из site.json или
   оставьте пустое id: макрос тогда не выведет ничего.

   Разметку vendor-сниппета не переписываем: загрузчик и <noscript>-пиксель
   Метрики должны совпадать с официальными, поэтому их однострочный
   inline-style (техническое скрытие картинки, а не оформление) оставлен
   как есть.
   ============================================================ #}
{% macro metrika() -%}
{%- set ym = site.analytics and site.analytics.yandexMetrika -%}
{%- if ym and ym.id %}
<!-- Yandex.Metrika counter -->
<script type="text/javascript">
  (function(m, e, t, r, i, k, a) {
    m[i] = m[i] || function() { (m[i].a = m[i].a || []).push(arguments) };
    m[i].l = 1 * new Date();
    for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
    k = e.createElement(t), a = e.getElementsByTagName(t)[0], k.async = 1, k.src = r, a.parentNode.insertBefore(k, a);
  })(window, document, 'script', '{{ ym.scriptUrl }}?id={{ ym.id }}', 'ym');

  ym({{ ym.id }}, 'init', { ssr: true, webvisor: true, clickmap: true, ecommerce: 'dataLayer', referrer: document.referrer, url: location.href, accurateTrackBounce: true, trackLinks: true });
</script>
<noscript>
  <div><img src="{{ ym.watchUrl }}{{ ym.id }}" style="position:absolute; left:-9999px;" alt=""></div>
</noscript>
<!-- /Yandex.Metrika counter -->
{%- endif %}
{%- endmacro %}
