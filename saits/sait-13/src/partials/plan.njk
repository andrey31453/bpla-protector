{# ============================================================
   plan.njk — условная схема площадки для блока «Контекст объекта».

   Композиция нарисована заново в палитре sait-13 (в прототипе схема была
   другой): периметр площадки с угловыми засечками, проезд вдоль нижней кромки
   с выездом по правому полю, обсуждаемая зона со штриховкой и пунктирным
   контуром, здание с осями и оборудованием внутри, условные зоны контроля,
   точки обследования и пунктирный маршрут подхода с открытой стрелкой.

   Масштаба нет и он не подразумевается: это схема для разговора о площадке,
   а не чертёж объекта (подпись в легенде говорит об этом прямо).

   Всё оформление — классы .plan* в style.css: цвета берутся из палитры сайта,
   толщины линий, шаг штриховки и штрих — из токенов --plan-* (единицы viewBox
   640×480, потому что SVG масштабируется целиком). Числовые координаты
   остаются в разметке, как у остальных схем сайта (sealPlate, bgScheme).
   Схема информативная, поэтому она не aria-hidden: смысл несёт aria-label
   из данных (поле plan.alt).
   ============================================================ #}
{% macro sitePlan(plan) -%}
<svg class="plan" viewBox="0 0 640 480" role="img" aria-label="{{ plan.alt }}" focusable="false">
  <defs>
    <pattern id="plan-hatch" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
      <path class="plan__hatch" d="M0 0V12"/>
    </pattern>
  </defs>
  {# поле площадки: чуть светлее подложки, чтобы контур читался как территория #}
  <rect class="plan__ground" x="40" y="36" width="560" height="408" rx="6"/>
  {# периметр: тонкая линия и четыре угловые засечки — условный контур площадки #}
  <rect class="plan__frame" x="40" y="36" width="560" height="408" rx="6"/>
  <g class="plan__corners">
    <path d="M40 68V36h32"/>
    <path d="M568 36h32v32"/>
    <path d="M600 412v32h-32"/>
    <path d="M72 444H40v-32"/>
  </g>
  {# проезды: полоса вдоль нижней кромки и выезд по правому полю, осевая пунктиром #}
  <path class="plan__road" d="M40 380H560V140"/>
  <path class="plan__road-line" d="M40 380H560V140"/>
  {# обсуждаемая зона: штриховка в медном тоне и пунктирный контур #}
  <rect class="plan__zone" x="104" y="96" width="300" height="232" rx="3"/>
  <rect class="plan__zone-edge" x="104" y="96" width="300" height="232" rx="3"/>
  {# здание: массив, внутренние оси и оборудование на площади #}
  <rect class="plan__building" x="140" y="132" width="228" height="164" rx="2"/>
  <path class="plan__cell" d="M216 132V296M292 132V296M140 178H368M140 224H368M140 270H368"/>
  <rect class="plan__unit" x="162" y="152" width="52" height="30" rx="1.5"/>
  <rect class="plan__unit" x="162" y="240" width="52" height="32" rx="1.5"/>
  {# условные зоны контроля у юго-западного угла площадки #}
  <circle class="plan__ring" cx="116" cy="316" r="24"/>
  <circle class="plan__ring" cx="116" cy="316" r="42"/>
  {# точки обследования по углам обсуждаемой зоны #}
  <g class="plan__markers">
    <circle class="plan__marker" cx="116" cy="108" r="5"/>
    <circle class="plan__marker" cx="392" cy="108" r="5"/>
    <circle class="plan__marker" cx="116" cy="316" r="5"/>
    <circle class="plan__marker" cx="392" cy="316" r="5"/>
  </g>
  {# маршрут подхода: пунктир и открытая стрелка у входа в зону #}
  <path class="plan__route" d="M596 62C556 92 470 104 404 120"/>
  <path class="plan__arrow" d="M420 114 404 120 410 136"/>
</svg>
{%- endmacro %}
